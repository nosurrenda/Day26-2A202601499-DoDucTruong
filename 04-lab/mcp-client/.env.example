# OpenRouter API Key (Lấy tại https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Tuỳ chọn model (mặc định: openrouter/google/gemini-2.5-flash)
OPENROUTER_MODEL=openrouter/google/gemini-2.5-flash

# Hoặc dùng Google Gemini API Key trực tiếp (https://aistudio.google.com/apikey)
# GOOGLE_API_KEY=your_gemini_api_key_here

# MCP Server URL
MCP_SERVER_URL=http://localhost:8085/mcp
